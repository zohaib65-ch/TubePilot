# Copy to .env.local and fill in.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/tubepilot

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Any Gemini model that supports video input and JSON output.
GEMINI_MODEL=gemini-flash-latest
# Optional. Tried when GEMINI_MODEL is overloaded (503) even after retries. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Google OAuth "Web application" client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this app. The OAuth redirect URI is ${APP_URL}/api/auth/google/callback
APP_URL=http://localhost:3000

# Signs session cookies and encrypts stored OAuth tokens. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Comma-separated Google emails allowed to sign in. Strongly recommended if the app is reachable by others.
ALLOWED_EMAILS=

# Optional. Where uploaded videos are kept until they are published to YouTube.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=1024
